<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.demetrius</groupId>
    <artifactId>tribunal-order-audit-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tribunal-order-audit-system</name>
    <description>tribunal-order-audit-system — 按领域拆分的微服务订单审单系统（Author: Demetrius2107）</description>

    <modules>
        <!-- R1 共享内核（core 核心层 / starter 起步依赖 / event 事件契约，全系统复用） -->
        <module>tribunal-common-core</module>
        <module>tribunal-common-starter</module>
        <module>tribunal-common-event</module>
        <!-- 系统一：订单审单系统（9 业务模块） -->
        <module>tribunal-order-auth-service</module>
        <module>tribunal-order-customer-service</module>
        <module>tribunal-order-service</module>
        <module>tribunal-order-inventory-service</module>
        <module>tribunal-order-billing-service</module>
        <module>tribunal-order-marketing-service</module>
        <module>tribunal-order-fulfillment-service</module>
        <module>tribunal-order-notification-service</module>
        <module>tribunal-order-task-service</module>
        <!-- 系统二：库存推送系统（上游数据集成网关） -->
        <module>tribunal-inventory-push-service</module>
        <!-- 系统三：金融结算系统（下游资金结算中枢） -->
        <module>tribunal-finance-settlement-service</module>
        <!-- M5: 微服务网关（统一入口、路由、鉴权前置） -->
        <module>tribunal-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM（OpenFeign/Gateway/CircuitBreaker 等） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（Nacos Discovery/Config） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- R1 共享内核版本管理 -->
            <dependency>
                <groupId>com.demetrius</groupId>
                <artifactId>tribunal-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.demetrius</groupId>
                <artifactId>tribunal-common-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.demetrius</groupId>
                <artifactId>tribunal-common-event</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <!-- CI 质量门槛：JaCoCo 覆盖率统计与门禁（N-204/质量门槛） -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                </plugin>
                <!-- CI 质量门槛：OWASP 依赖漏洞扫描（独立 job 手动触发，不绑定主构建） -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>10.0.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- 统一接入 JaCoCo：测试插桩 + 报告 + 覆盖率门禁（LINE≥0.20 / BRANCH≥0.10，绑定 verify） -->
        <!-- 门槛说明：共享内核（common-starter）以自动装配/基建类为主，覆盖率天然偏低；
             门禁目标是兜底"完全无测试"的模块并防覆盖率倒退，而非追求高覆盖 -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 各服务启动类与接口 DTO 不纳入覆盖率统计 -->
                        <exclude>**/*Application.class</exclude>
                        <exclude>**/interfaces/dto/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.20</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.10</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
