<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.demetrius</groupId>
        <artifactId>tribunal-order-audit-system</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>tribunal-common-starter</artifactId>
    <name>tribunal-common-starter</name>
    <description>R1 共享内核·起步依赖：鉴权自动装配（JWT 解析/拦截器/RBAC 注解）+ MyBatis-Plus（分页/乐观锁）+ Feign 内部 Token。服务引入即生效。</description>

    <dependencies>
        <!-- 依赖核心层（ApiResponse/BizException/DTO） -->
        <dependency>
            <groupId>com.demetrius</groupId>
            <artifactId>tribunal-common-core</artifactId>
        </dependency>

        <!-- 鉴权：JWT 解析（密钥由各服务 jwt.secret 配置） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot 自动装配（@AutoConfiguration/@ConditionalOnXxx） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Web 拦截器（AuthInterceptor 依赖 MVC 接口），由消费方 web starter 提供 → optional -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Feign 内部 Token 拦截器，由消费方 openfeign 提供 → optional -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MyBatis-Plus 自动装配（分页/乐观锁），由消费方 mybatis-plus 提供 → optional -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Kafka 错误处理自动装配（重试+DLQ），由消费方 spring-kafka 提供 → optional -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- M5: Nacos 服务发现（optional，服务声明 spring.cloud.nacos.discovery.enabled 启用） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- M5: Resilience4j 熔断/降级（optional，消费方需引入 spring-cloud-starter-circuitbreaker-resilience4j） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- M5: Redis 分布式幂等/登录锁定/RefreshToken（optional） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
